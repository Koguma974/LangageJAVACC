options {
  STATIC = false;
  DEBUG_PARSER = false;
  LOOKAHEAD = 2;
}

PARSER_BEGIN(Interpreter)

import java.util.*;
import java.io.*;

public class Interpreter {
  // Simple AST node classes as inner classes
  static class ASTNode {}

  static class Program extends ASTNode {
    List declarations;
    List functions;
    List procedures;
    Object main;
  }

  static class Block extends ASTNode {
    List statements;
  }

  static class VarDecl extends ASTNode {
    String type;
    List names;
  }

  static class Assignment extends ASTNode {
    String varName;
    Object index;
    Object value;
  }

  static class IfStmt extends ASTNode {
    Object condition;
    Object thenBlock;
    Object elseBlock;
  }

  static class WhileStmt extends ASTNode {
    Object condition;
    Object body;
  }

  static class PrintStmt extends ASTNode {
    Object expression;
  }

  static class ReturnStmt extends ASTNode {
    Object value;
  }

  static class FuncCall extends ASTNode {
    String name;
    List args;
  }

  static class FuncDef extends ASTNode {
    String name;
    String returnType;
    List params;
    Object body;
  }

  static class ProcDef extends ASTNode {
    String name;
    List params;
    Object body;
  }

  static class Param extends ASTNode {
    String type;
    String name;
  }

  static class BinaryExpr extends ASTNode {
    String operator;
    Object left;
    Object right;
  }

  static class UnaryExpr extends ASTNode {
    String operator;
    Object operand;
  }

  static class Variable extends ASTNode {
    String name;
    Object index;
  }

  static class Literal extends ASTNode {
    Object value;
  }

  static class ArrayLiteral extends ASTNode {
    List elements;
  }

  static class InputExpr extends ASTNode {}

  // Interpreter state
  private Map globalVars = new HashMap();
  private Map functions = new HashMap();
  private Map procedures = new HashMap();
  private Stack scopes = new Stack();
  private boolean hasReturned = false;
  private Object returnValue = null;

  // Helper methods
  private void pushScope() {
    scopes.push(new HashMap());
  }

  private void popScope() {
    if (!scopes.isEmpty()) scopes.pop();
  }

  private void setVar(String name, Object value) {
    if (!scopes.isEmpty()) {
      ((Map)scopes.peek()).put(name, value);
    } else {
      globalVars.put(name, value);
    }
  }

  private Object getVar(String name) {
    for (int i = scopes.size() - 1; i >= 0; i--) {
      Map scope = (Map)scopes.get(i);
      if (scope.containsKey(name)) {
        return scope.get(name);
      }
    }
    return globalVars.get(name);
  }

  private Object getDefaultValue(String type) {
    if (type.equals("int")) return Integer.valueOf(0);
    if (type.equals("float")) return Double.valueOf(0.0);
    if (type.equals("string")) return "";
    if (type.equals("boolean")) return Boolean.FALSE;
    if (type.equals("int[]")) return new ArrayList();
    if (type.equals("float[]")) return new ArrayList();
    if (type.equals("string[]")) return new ArrayList();
    if (type.equals("boolean[]")) return new ArrayList();
    return null;
  }

  // Execution methods
  private void executeProgram(Program program) {
    if (program.declarations != null) {
      for (int i = 0; i < program.declarations.size(); i++) {
        execute(program.declarations.get(i));
      }
    }

    if (program.functions != null) {
      for (int i = 0; i < program.functions.size(); i++) {
        FuncDef func = (FuncDef)program.functions.get(i);
        functions.put(func.name, func);
      }
    }

    if (program.procedures != null) {
      for (int i = 0; i < program.procedures.size(); i++) {
        ProcDef proc = (ProcDef)program.procedures.get(i);
        procedures.put(proc.name, proc);
      }
    }

    if (program.main != null) {
      execute(program.main);
    }
  }

  private Object execute(Object node) {
    if (node == null) return null;

    if (node instanceof Block) {
      return executeBlock((Block)node);
    } else if (node instanceof VarDecl) {
      return executeVarDecl((VarDecl)node);
    } else if (node instanceof Assignment) {
      return executeAssignment((Assignment)node);
    } else if (node instanceof IfStmt) {
      return executeIf((IfStmt)node);
    } else if (node instanceof WhileStmt) {
      return executeWhile((WhileStmt)node);
    } else if (node instanceof PrintStmt) {
      return executePrint((PrintStmt)node);
    } else if (node instanceof ReturnStmt) {
      return executeReturn((ReturnStmt)node);
    } else if (node instanceof FuncCall) {
      return executeFuncCall((FuncCall)node);
    } else if (node instanceof BinaryExpr) {
      return evaluateBinary((BinaryExpr)node);
    } else if (node instanceof UnaryExpr) {
      return evaluateUnary((UnaryExpr)node);
    } else if (node instanceof Variable) {
      return evaluateVariable((Variable)node);
    } else if (node instanceof Literal) {
      return ((Literal)node).value;
    } else if (node instanceof ArrayLiteral) {
      return evaluateArrayLiteral((ArrayLiteral)node);
    } else if (node instanceof InputExpr) {
      Scanner sc = new Scanner(System.in);
      return sc.nextLine();
    }

    return null;
  }

  private Object executeBlock(Block block) {
    pushScope();
    Object result = null;

    if (block.statements != null) {
      for (int i = 0; i < block.statements.size(); i++) {
        result = execute(block.statements.get(i));
        if (hasReturned) break;
      }
    }

    popScope();
    return result;
  }

  private Object executeVarDecl(VarDecl decl) {
    Object defaultValue = getDefaultValue(decl.type);
    for (int i = 0; i < decl.names.size(); i++) {
      String name = (String)decl.names.get(i);
      setVar(name, defaultValue);
    }
    return null;
  }

  private Object executeAssignment(Assignment assign) {
    Object value = execute(assign.value);

    if (assign.index != null) {
      Object array = getVar(assign.varName);
      if (array instanceof List) {
        int idx = ((Number)execute(assign.index)).intValue();
        List list = (List)array;
        while (list.size() <= idx) {
          list.add(getDefaultValueForArray(array));
        }
        list.set(idx, value);
      }
    } else {
      setVar(assign.varName, value);
    }

    return value;
  }

  private Object getDefaultValueForArray(Object array) {
    if (array instanceof List && !((List)array).isEmpty()) {
      Object first = ((List)array).get(0);
      if (first instanceof Integer) return Integer.valueOf(0);
      if (first instanceof Double) return Double.valueOf(0.0);
      if (first instanceof String) return "";
      if (first instanceof Boolean) return Boolean.FALSE;
    }
    return Integer.valueOf(0);
  }

  private Object executeIf(IfStmt ifStmt) {
    boolean cond = ((Boolean)execute(ifStmt.condition)).booleanValue();
    if (cond) {
      return execute(ifStmt.thenBlock);
    } else if (ifStmt.elseBlock != null) {
      return execute(ifStmt.elseBlock);
    }
    return null;
  }

  private Object executeWhile(WhileStmt whileStmt) {
    Object result = null;
    while (true) {
      boolean cond = ((Boolean)execute(whileStmt.condition)).booleanValue();
      if (!cond) break;
      result = execute(whileStmt.body);
      if (hasReturned) break;
    }
    return result;
  }

  private Object executePrint(PrintStmt print) {
    Object value = execute(print.expression);
    System.out.println(value);
    return null;
  }

  private Object executeReturn(ReturnStmt ret) {
    hasReturned = true;
    if (ret.value != null) {
      returnValue = execute(ret.value);
    } else {
      returnValue = null;
    }
    throw new RuntimeException("Return");
  }

  private Object executeFuncCall(FuncCall call) {
    System.out.println("Calling: " + call.name);
    return null;
  }

  private Object evaluateBinary(BinaryExpr expr) {
    Object left = execute(expr.left);
    Object right = execute(expr.right);

    if (expr.operator.equals("+")) {
      if (left instanceof Number && right instanceof Number) {
        return Double.valueOf(((Number)left).doubleValue() + ((Number)right).doubleValue());
      }
      return left.toString() + right.toString();
    } else if (expr.operator.equals("-")) {
      return Double.valueOf(((Number)left).doubleValue() - ((Number)right).doubleValue());
    } else if (expr.operator.equals("*")) {
      return Double.valueOf(((Number)left).doubleValue() * ((Number)right).doubleValue());
    } else if (expr.operator.equals("/")) {
      double divisor = ((Number)right).doubleValue();
      return divisor == 0 ? Double.valueOf(0) : Double.valueOf(((Number)left).doubleValue() / divisor);
    } else if (expr.operator.equals("and")) {
      return Boolean.valueOf(((Boolean)left).booleanValue() && ((Boolean)right).booleanValue());
    } else if (expr.operator.equals("or")) {
      return Boolean.valueOf(((Boolean)left).booleanValue() || ((Boolean)right).booleanValue());
    } else if (expr.operator.equals("=")) {
      if (left instanceof Number && right instanceof Number) {
        return Boolean.valueOf(((Number)left).doubleValue() == ((Number)right).doubleValue());
      }
      return Boolean.valueOf(left.equals(right));
    } else if (expr.operator.equals("!=")) {
      return Boolean.valueOf(!left.equals(right));
    } else if (expr.operator.equals("<")) {
      return Boolean.valueOf(((Number)left).doubleValue() < ((Number)right).doubleValue());
    } else if (expr.operator.equals(">")) {
      return Boolean.valueOf(((Number)left).doubleValue() > ((Number)right).doubleValue());
    } else if (expr.operator.equals("<=")) {
      return Boolean.valueOf(((Number)left).doubleValue() <= ((Number)right).doubleValue());
    } else if (expr.operator.equals(">=")) {
      return Boolean.valueOf(((Number)left).doubleValue() >= ((Number)right).doubleValue());
    }
    return null;
  }

  private Object evaluateUnary(UnaryExpr expr) {
    Object value = execute(expr.operand);
    if (expr.operator.equals("!")) {
      return Boolean.valueOf(!((Boolean)value).booleanValue());
    } else if (expr.operator.equals("-")) {
      return Double.valueOf(-((Number)value).doubleValue());
    }
    return value;
  }

  private Object evaluateVariable(Variable var) {
    Object value = getVar(var.name);
    if (value == null) {
      return Integer.valueOf(0);
    }

    if (var.index != null && value instanceof List) {
      int idx = ((Number)execute(var.index)).intValue();
      List list = (List)value;
      if (idx >= 0 && idx < list.size()) {
        return list.get(idx);
      }
      return getDefaultValueForArray(value);
    }

    return value;
  }

  private Object evaluateArrayLiteral(ArrayLiteral array) {
    List result = new ArrayList();
    if (array.elements != null) {
      for (int i = 0; i < array.elements.size(); i++) {
        result.add(execute(array.elements.get(i)));
      }
    }
    return result;
  }

  public static void main(String[] args) throws Exception {
    if (args.length == 0) {
      System.out.println("Usage: java Interpreter <filename>");
      return;
    }

    try {
      Interpreter parser = new Interpreter(new FileInputStream(args[0]));
      parser.Programme();
      System.out.println("Program executed successfully.");
    } catch (FileNotFoundException e) {
      System.out.println("File not found: " + args[0]);
    } catch (ParseException e) {
      System.out.println("Parse error: " + e.getMessage());
      System.out.println("Token: " + e.currentToken.image + " at line " +
                        e.currentToken.beginLine + ", column " + e.currentToken.beginColumn);
    } catch (Exception e) {
      System.out.println("Runtime error: " + e.getMessage());
      e.printStackTrace();
    }
  }
}

PARSER_END(Interpreter)

SKIP: { " " | "\t" | "\n" | "\r" }

SKIP: { <"//" (~["\n","\r"])* ("\n"|"\r"|"\r\n")> }

TOKEN: {
  <FUN: "fun">
| <PROC: "proc">
| <MAIN: "main">
| <IF: "if">
| <ELSE: "else">
| <WHILE: "while">
| <RETURN: "return">
| <PRINT: "print">
| <INPUT: "input">
| <TRUE: "true">
| <FALSE: "false">
| <INT_TYPE: "int">
| <FLOAT_TYPE: "float">
| <STRING_TYPE: "string">
| <BOOLEAN_TYPE: "boolean">
| <AND: "and">
| <OR: "or">
}

TOKEN: {
  <ASSIGN: ":=">
| <EQ: "=">
| <NEQ: "!=">
| <LT: "<">
| <GT: ">">
| <LE: "<=">
| <GE: ">=">
| <PLUS: "+">
| <MINUS: "-">
| <MULT: "*">
| <DIV: "/">
| <NOT: "!">
| <LPAREN: "(">
| <RPAREN: ")">
| <LBRACE: "{">
| <RBRACE: "}">
| <LBRACK: "[">
| <RBRACK: "]">
| <SEMICOLON: ";">
| <COMMA: ",">
}

TOKEN: {
  <FLOAT_LIT: (["0"-"9"])+ "." (["0"-"9"])+>
| <INTEGER: (["0"-"9"])+>
| <STRING_LIT: "\"" (~["\"","\\"] | "\\" ~[])* "\"">
| <IDENTIFIER: ["a"-"z","A"-"Z","_"](["a"-"z","A"-"Z","0"-"9","_"])*>
}

void Programme(): {
  Program program = new Program();
  program.declarations = new ArrayList();
  program.functions = new ArrayList();
  program.procedures = new ArrayList();
  Object decl;
  Object func;
  Object proc;
} {
  (decl = DeclarationVar() { program.declarations.add(decl); })*
  (func = DeclarationFunc() { program.functions.add(func); })*
  (proc = DeclarationProc() { program.procedures.add(proc); })*
  program.main = Main()
  {
    executeProgram(program);
  }
}

Object DeclarationVar(): {
  VarDecl decl = new VarDecl();
} {
  decl.type = Type()
  decl.names = ListeIdentifiantVar()
  <SEMICOLON>
  { return decl; }
}

List ListeIdentifiantVar(): {
  List ids = new ArrayList();
  Token t;
} {
  t = <IDENTIFIER> { ids.add(t.image); }
  (<COMMA> t = <IDENTIFIER> { ids.add(t.image); })*
  { return ids; }
}

String Type(): {
  String base = "";
} {
  (
    <INT_TYPE> { base = "int"; }
  | <FLOAT_TYPE> { base = "float"; }
  | <STRING_TYPE> { base = "string"; }
  | <BOOLEAN_TYPE> { base = "boolean"; }
  )
  (
    <LBRACK> <RBRACK> { base += "[]"; }
  )?
  { return base; }
}

Object DeclarationFunc(): {
  FuncDef func = new FuncDef();
  Token name;
} {
  <FUN> <LPAREN> func.returnType = Type() <RPAREN>
  name = <IDENTIFIER> { func.name = name.image; }
  <LPAREN> func.params = ListeParam() <RPAREN>
  <LBRACE>
  func.body = BlockContent()
  <RBRACE>
  { return func; }
}

Object DeclarationProc(): {
  ProcDef proc = new ProcDef();
  Token name;
} {
  <PROC>
  name = <IDENTIFIER> { proc.name = name.image; }
  <LPAREN> proc.params = ListeParam() <RPAREN>
  <LBRACE>
  proc.body = BlockContent()
  <RBRACE>
  { return proc; }
}

List ListeParam(): {
  List params = new ArrayList();
  Object p;
} {
  (p = DeclarationParam() { params.add(p); } (<COMMA> p = DeclarationParam() { params.add(p); })*)?
  { return params; }
}

Object DeclarationParam(): {
  Param param = new Param();
  Token name;
} {
  param.type = Type()
  name = <IDENTIFIER> { param.name = name.image; }
  { return param; }
}

Object Main(): {
  Block block = new Block();
} {
  <MAIN>
  <LBRACE>
  block.statements = ListeInstructions()
  <RBRACE>
  { return block; }
}

Object BlockContent(): {
  Block block = new Block();
  block.statements = new ArrayList();
  Object decl;
  Object stmt;
} {
  (decl = DeclarationVar() { block.statements.add(decl); })*
  (stmt = Instruction() { block.statements.add(stmt); })*
  { return block; }
}

Object Instruction(): {
  Object stmt;
} {
    stmt = Affectation() <SEMICOLON> { return stmt; }
  | stmt = Si() { return stmt; }
  | stmt = TantQue() { return stmt; }
  | stmt = Retour() <SEMICOLON> { return stmt; }
  | stmt = AppelProc() <SEMICOLON> { return stmt; }
  | stmt = Affichage() <SEMICOLON> { return stmt; }
  | stmt = Bloc() { return stmt; }
}

Object Bloc(): {
  Block block = new Block();
} {
  <LBRACE>
  block.statements = ListeInstructions()
  <RBRACE>
  { return block; }
}

List ListeInstructions(): {
  List stmts = new ArrayList();
  Object stmt;
} {
  (stmt = Instruction() { stmts.add(stmt); })*
  { return stmts; }
}

Object Affectation(): {
  Assignment assign = new Assignment();
} {
  assign.varName = NomVariable()
  (
    <LBRACK> assign.index = ExprArith() <RBRACK>
  )?
  <ASSIGN>
  assign.value = Expr()
  { return assign; }
}

String NomVariable(): {
  Token t;
} {
  t = <IDENTIFIER>
  { return t.image; }
}

Object Si(): {
  IfStmt ifStmt = new IfStmt();
} {
  <IF> <LPAREN> ifStmt.condition = ExprLog() <RPAREN>
  ifStmt.thenBlock = Bloc()
  [
    <ELSE> ifStmt.elseBlock = Bloc()
  ]
  { return ifStmt; }
}

Object TantQue(): {
  WhileStmt whileStmt = new WhileStmt();
} {
  <WHILE> <LPAREN> whileStmt.condition = ExprLog() <RPAREN>
  whileStmt.body = Bloc()
  { return whileStmt; }
}

Object Retour(): {
  ReturnStmt ret = new ReturnStmt();
} {
  <RETURN> ret.value = Expr()
  { return ret; }
}

Object AppelProc(): {
  FuncCall call = new FuncCall();
  Token name;
} {
  name = <IDENTIFIER> { call.name = name.image; }
  <LPAREN> call.args = ListeArgs() <RPAREN>
  { return call; }
}

Object Affichage(): {
  PrintStmt print = new PrintStmt();
} {
  <PRINT> <LPAREN> print.expression = Expr() <RPAREN>
  { return print; }
}

Object Expr(): {
  Object expr;
} {
    LOOKAHEAD(<INPUT> <LPAREN>) expr = ExprString() { return expr; }
  | LOOKAHEAD(<STRING_LIT>) expr = ExprString() { return expr; }
  | LOOKAHEAD(<LBRACK>) expr = ArrayLiteralExpr() { return expr; }
  | LOOKAHEAD(ExprArith() (<GT>|<LT>|<GE>|<LE>|<EQ>|<NEQ>)) expr = ExprLog() { return expr; }
  | LOOKAHEAD(<TRUE>|<FALSE>|<NOT>) expr = ExprLog() { return expr; }
  | LOOKAHEAD(<LPAREN> ExprLog()) expr = ExprLog() { return expr; }
  | expr = ExprArith() { return expr; }
}

Object ExprLog(): {
  Object left, right;
  BinaryExpr bin;
} {
  left = EltLog()
  (
    <OR> right = EltLog() {
      bin = new BinaryExpr();
      bin.operator = "or";
      bin.left = left;
      bin.right = right;
      left = bin;
    }
  )*
  { return left; }
}

Object EltLog(): {
  Object left, right;
  BinaryExpr bin;
} {
  left = TermeLog()
  (
    <AND> right = TermeLog() {
      bin = new BinaryExpr();
      bin.operator = "and";
      bin.left = left;
      bin.right = right;
      left = bin;
    }
  )*
  { return left; }
}

Object TermeLog(): {
  Object val;
  UnaryExpr unary;
} {
    <NOT> val = ValLog() {
      unary = new UnaryExpr();
      unary.operator = "!";
      unary.operand = val;
      return unary;
    }
  | val = ValLog() { return val; }
}

Object ValLog(): {
  Object expr;
  Token t;
  Object index = null;
  Variable var;
  Literal lit;
} {
    <TRUE> {
      lit = new Literal();
      lit.value = Boolean.TRUE;
      return lit;
    }
  | <FALSE> {
      lit = new Literal();
      lit.value = Boolean.FALSE;
      return lit;
    }
  | <LPAREN> expr = ExprLog() <RPAREN> { return expr; }
  | LOOKAHEAD(ExprArith() (<GT>|<LT>|<GE>|<LE>|<EQ>|<NEQ>)) expr = Comp() { return expr; }
  | t = <IDENTIFIER> {
      var = new Variable();
      var.name = t.image;
      var.index = null;
    }
    (
      <LBRACK> index = ExprArith() <RBRACK> { var.index = index; }
    )?
    { return var; }
}

Object Comp(): {
  Object left, right;
  String op;
  BinaryExpr bin;
} {
  left = ExprArith()
  op = OpComp()
  right = ExprArith()
  {
    bin = new BinaryExpr();
    bin.operator = op;
    bin.left = left;
    bin.right = right;
    return bin;
  }
}

String OpComp(): {} {
    <GT> { return ">"; }
  | <LT> { return "<"; }
  | <GE> { return ">="; }
  | <LE> { return "<="; }
  | <EQ> { return "="; }
  | <NEQ> { return "!="; }
}

Object ExprArith(): {
  Object left, right;
  BinaryExpr bin;
} {
  left = EltArith()
  (
      <PLUS> right = EltArith() {
        bin = new BinaryExpr();
        bin.operator = "+";
        bin.left = left;
        bin.right = right;
        left = bin;
      }
    | <MINUS> right = EltArith() {
        bin = new BinaryExpr();
        bin.operator = "-";
        bin.left = left;
        bin.right = right;
        left = bin;
      }
  )*
  { return left; }
}

Object EltArith(): {
  Object left, right;
  BinaryExpr bin;
} {
  left = TermArith()
  (
      <MULT> right = TermArith() {
        bin = new BinaryExpr();
        bin.operator = "*";
        bin.left = left;
        bin.right = right;
        left = bin;
      }
    | <DIV> right = TermArith() {
        bin = new BinaryExpr();
        bin.operator = "/";
        bin.left = left;
        bin.right = right;
        left = bin;
      }
  )*
  { return left; }
}

Object TermArith(): {
  Object val;
  UnaryExpr unary;
} {
    <MINUS> val = ValArith() {
      unary = new UnaryExpr();
      unary.operator = "-";
      unary.operand = val;
      return unary;
    }
  | val = ValArith() { return val; }
}

Object ValArith(): {
  Token t;
  Object val;
  Object index = null;
  Variable var;
  Object arr;
  Literal lit;
} {
    t = <INTEGER> {
      lit = new Literal();
      lit.value = Integer.valueOf(Integer.parseInt(t.image));
      return lit;
    }
  | t = <FLOAT_LIT> {
      lit = new Literal();
      lit.value = Double.valueOf(Double.parseDouble(t.image));
      return lit;
    }
  | <LPAREN> val = ExprArith() <RPAREN> { return val; }
  | LOOKAHEAD(2) arr = ArrayLiteralExpr() { return arr; }
  | t = <IDENTIFIER> {
      var = new Variable();
      var.name = t.image;
      var.index = null;
    }
    (
      <LBRACK> index = ExprArith() <RBRACK> { var.index = index; }
    )?
    { return var; }
}

Object ArrayLiteralExpr(): {
  ArrayLiteral arr = new ArrayLiteral();
  arr.elements = new ArrayList();
  Object elem;
} {
  <LBRACK>
  (
    elem = Expr() { arr.elements.add(elem); }
    (<COMMA> elem = Expr() { arr.elements.add(elem); })*
  )?
  <RBRACK>
  { return arr; }
}

Object ExprString(): {
  Object result;
  Object next;
  BinaryExpr bin;
  InputExpr input;
} {
    <INPUT> <LPAREN> <RPAREN> {
      input = new InputExpr();
      return input;
    }
  | result = TermeString()
    (
      <PLUS> next = TermeString() {
        bin = new BinaryExpr();
        bin.operator = "+";
        bin.left = result;
        bin.right = next;
        result = bin;
      }
    )*
    { return result; }
}

Object TermeString(): {
  Token t;
  Object val;
  Variable var;
  Literal lit;
} {
    t = <STRING_LIT> {
      lit = new Literal();
      lit.value = t.image.substring(1, t.image.length() - 1);
      return lit;
    }
  | <LPAREN> val = ExprArith() <RPAREN> { return val; }
  | t = <IDENTIFIER> {
      var = new Variable();
      var.name = t.image;
      var.index = null;
      return var;
    }
}

List ListeArgs(): {
  List args = new ArrayList();
  Object arg;
} {
  (
    arg = Expr() { args.add(arg); }
    (<COMMA> arg = Expr() { args.add(arg); })*
  )?
  { return args; }
}